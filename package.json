{
  "name": "md-tree-generator",
  "displayName": "md-tree-generator",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:treeGenerator.create"
  ],
  "main": "./out/extension.js",
  "contributes": {

    "commands": [
      {
        "command": "mdTreeGenerator.create",
        "title": "根据目录树生成文件结构"
      }
    ],


    "menus": {

      "explorer/context": [
        {
          "command": "mdTreeGenerator.create",
          "group": "navigation",
          "when": "resourceExtname == .md"
        }
      ]

    }

  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "build": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
